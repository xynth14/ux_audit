# Copia este archivo como .env y rellena los valores.
# El archivo .env NUNCA se lee desde el chat: solo lo consume el navegador.

APP_URL=https://ejemplo.com
APP_USER=usuario@dominio.com
APP_PASS=tu-password

# true  = producción: no envía formularios ni confirma acciones (solo observa)
# false = staging: navega libremente
SAFE_MODE=true
